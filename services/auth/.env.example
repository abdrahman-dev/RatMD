PORT=5000
MONGODB_URL=mongodb://localhost:27017/ratmd
MONGODB_USERNAME="replace_with_your_mongodb_username_here"
MONGODB_PASSWORD="replace_with_your_mongodb_password_here"
ACCESS_TOKEN_SECRET=replace_with_at_least_32_char_random_string_here
REFRESH_TOKEN_SECRET=replace_with_at_least_32_char_random_string_here
ENCRYPTION_SECRET=replace_with_at_least_32_char_random_string_here
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Optional — OpenRouter LLM enhancement (BYO key, has defaults)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
